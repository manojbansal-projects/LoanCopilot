# ── LLM ──────────────────────────────────────────────────────────────────────
# Paste your API key here (OpenAI, Vocarium, or any OpenAI-compatible provider).
OPENAI_API_KEY=<your-api-key-here>
# If using Vocarium or another provider, set their base URL below.
# For standard OpenAI, leave this blank.
OPENAI_BASE_URL=

# ── Observability (Langfuse — cloud or self-hosted) ──────────────────────────
# Cloud: sign up at cloud.langfuse.com → Settings → API Keys
# Self-hosted: set LANGFUSE_HOST=http://localhost:3000 and run docker compose up -d
# Note: LANGFUSE_HOST and LANGFUSE_BASE_URL are equivalent — either works.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Storage ──────────────────────────────────────────────────────────────────
CHROMA_DB_PATH=./knowledge/chromadb
KNOWLEDGE_BASE_PATH=./knowledge/raw
PROCESSED_DOCS_PATH=./knowledge/processed

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_DIR=./logs
LOG_LEVEL=INFO

# ── Agent settings ───────────────────────────────────────────────────────────
AGENT_MODEL=gpt-4o
SAFETY_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
MEMORY_WINDOW=10
RAG_TOP_K=3
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100

# ── Deployment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
STREAMLIT_PORT=8501
MCP_SERVER_PORT=8080
